<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows Cleanup 0.3.0" Width="1080" Height="760" MinWidth="880" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CED8E4"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,8"/></Style>
 </Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="WINDOWS CLEANUP" Foreground="#2364AA" FontWeight="Bold" FontSize="12"/>
   <TextBlock Text="Make room for what matters." FontSize="30" FontWeight="SemiBold" Foreground="#172B46" Margin="0,4,0,6"/>
   <TextBlock Text="Inspect your disk, review the findings, and choose when to proceed." Foreground="#53657A"/>
  </StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="01  Inspect without deleting" FontSize="18" FontWeight="SemiBold"/>
     <CheckBox x:Name="Diagnostics" Content="Additional diagnostics - requires administrator approval"/>
     <TextBlock x:Name="Runtime" Foreground="#53657A" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
    <Button x:Name="Inspect" Grid.Column="1" Content="New inspection" Background="#205DB6" Foreground="White" BorderThickness="0" VerticalAlignment="Center" Margin="18,0,0,0"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><TextBlock Text="02  Reports and history" FontSize="18" FontWeight="SemiBold"/><Button x:Name="Refresh" Content="Refresh" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0" Padding="10,4"/></DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="History" DisplayMemberPath="Label" MinHeight="34" VerticalContentAlignment="Center"/>
     <Button x:Name="InspectionReport" Grid.Column="1" Content="Inspection" Margin="10,0,0,0" Padding="12,5"/>
     <Button x:Name="CleanupReport" Grid.Column="2" Content="Result" Margin="10,0,0,0" Padding="12,5"/>
    </Grid>
    <TextBox x:Name="Report" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="#DFE6EF" Background="#FAFCFE" Padding="14" FontSize="13" Text="Your inspection report will appear here. An inspection may take several minutes."/>
    <Border x:Name="ApprovalPanel" Grid.Row="3" Visibility="Collapsed" Background="#FFF4DE" Padding="12" Margin="0,8,0,0">
     <StackPanel><TextBlock Text="Your response is required" FontWeight="Bold"/>
      <TextBox x:Name="ApprovalDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="90" Margin="0,8,0,8"/>
      <ScrollViewer MaxHeight="65" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Questions"/></ScrollViewer>
      <StackPanel Orientation="Horizontal"><Button x:Name="Approve" Content="Approve this request"/><Button x:Name="Reject" Content="Reject"/></StackPanel>
     </StackPanel>
    </Border>
    <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><CheckBox x:Name="Reviewed" Content="I have read the inspection report"/>
      <StackPanel Orientation="Horizontal"><TextBlock Text="Type CLEAN to authorize this plan:" VerticalAlignment="Center"/><TextBox x:Name="Confirmation" Width="95" Margin="8,0,0,0" Padding="6"/></StackPanel>
     </StackPanel>
     <Button x:Name="Clean" Grid.Column="1" Content="Continue to Clean >" Margin="12,0,0,0"/>
    </Grid>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <DockPanel Margin="0,0,0,4"><Button x:Name="Stop" Content="Stop Clean" DockPanel.Dock="Right" HorizontalAlignment="Right" IsEnabled="False" Margin="12,0,0,0" Padding="12,5"/><TextBlock Text="Stop requests a safe interruption. Completed actions are not undone." Foreground="#67788D" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
   <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="False" Foreground="#205DB6" Background="#DFE6EF"/>
   <TextBlock x:Name="Status" Text="Ready. Cleanup requires separate approval in Codex." Margin="0,8,0,4" Foreground="#334D6B" TextWrapping="Wrap"/>
   <TextBlock Text="Clean runs here. Review each requested action before approving it. Windows may show a separate administrator prompt." Foreground="#67788D" FontSize="12" TextWrapping="Wrap"/>
  </StackPanel>
 </Grid>
</Window>
